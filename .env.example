# Copy to `.env.local` and fill in real values. `.env.local` is git-ignored.

# MongoDB Atlas connection string (without a database in the path — see MONGODB_DB).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0"

# Database name used by every model.
MONGODB_DB="a_pes_studio"

# Secret used to sign the admin session JWT (HS256).
# Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-32-byte-random-string"

# Google Analytics 4 measurement ID. Optional — falls back to the built-in ID.
NEXT_PUBLIC_GA_ID="G-E2E1JJF7YQ"

# --- Cloudflare R2 --------------------------------------------------------
# Optional as a group: leave every value empty and the CMS still accepts image
# URLs, it just hides the upload button. Set all five to enable uploads.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public base URL of the bucket, no trailing slash (r2.dev domain or your own).
R2_PUBLIC_BASE_URL=""
